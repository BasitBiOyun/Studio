{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/repair-editor-sidebar.cjs",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "test:data-layer": "tsx scripts/data-layer-selftest.ts && tsx scripts/data-migration-selftest.ts",
    "test:templates": "tsx scripts/template-selftest.ts && tsx scripts/thread-cover-selftest.ts",
    "test:sidebar": "tsx scripts/sidebar-runtime-selftest.ts",
    "prebuild": "node scripts/repair-editor-sidebar.cjs",
    "build": "npm run test:sidebar && npm run test:data-layer && npm run test:templates && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@scena/guides": "^0.29.2",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@zumer/snapdom": "^2.24.12",
    "browser-image-compression": "^2.0.2",
    "dexie": "^4.4.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "flag-icons": "^7.5.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-vibrant": "^4.0.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-easy-crop": "^6.2.3",
    "react-moveable": "^0.56.0",
    "react-selecto": "^1.26.3",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
